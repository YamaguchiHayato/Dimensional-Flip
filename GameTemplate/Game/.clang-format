# ============================================================
# .clang-format
# ============================================================
# clang-format は、C/C++/C#/Objective-C などのコード整形ツールです。
# ここでは Visual Studio と DirectX/C++ の標準スタイルに近い設定を採用。
#
# 特徴：
#   - 括弧は Allman スタイル（改行して { を置く）
#   - インデント4スペース
#   - ポインタは型の左に * を寄せる (int* p;)
#   - 行長120文字
#   - Include順序の自動整列を有効化
#
# Visual Studio 2022 以降では、Ctrl+K, D や保存時整形でこの設定が反映されます。
# ============================================================

# Microsoft 形式をベースに細部をカスタマイズ
BasedOnStyle: Microsoft

# ------------------------------------------------------------
# インデント設定
# ------------------------------------------------------------
IndentWidth: 4          # インデントは4スペース
TabWidth: 4             # タブの表示幅（通常4）
UseTab: Never           # タブ文字は使わずスペースで統一

# ------------------------------------------------------------
# 括弧・レイアウト
# ------------------------------------------------------------
BreakBeforeBraces: Allman   # { は改行して配置（Allmanスタイル）
AccessModifierOffset: -4    # public:/private: などを左寄せ
AllowShortFunctionsOnASingleLine: Inline  # 短い関数は1行で許可

# ------------------------------------------------------------
# スペースと整形
# ------------------------------------------------------------
PointerAlignment: Left      # ポインタの * は型に寄せる（int* p）
SpaceAfterCStyleCast: true  # (int)x → (int) x にスペースを入れる
SpaceBeforeParens: ControlStatements  # if, while の後にスペースを入れる

# ------------------------------------------------------------
# 改行・行長
# ------------------------------------------------------------
ColumnLimit: 120            # 1行の最大文字数（0で無制限）

# ------------------------------------------------------------
# include順序と整理
# ------------------------------------------------------------
SortIncludes: true          # include文をアルファベット順にソート
IncludeBlocks: Regroup      # 空行で分けたブロックごとにグループ化

# ------------------------------------------------------------
# 名前空間のインデント
# ------------------------------------------------------------
NamespaceIndentation: All    # namespace ブロック内もインデントする


# ★ ここで stdafx.h を最優先カテゴリに固定（常に最上段へ）
#   - 必要なら "pch.h" を追加してもOK（コメント外して使用）
IncludeCategories:
  - Regex: '^"stdafx\.h"$'
    Priority: 0
  # - Regex: '^"pch\.h"$'
  #   Priority: 0
  - Regex: '^<.*>$'         # 標準/サードパーティ（<...>）
    Priority: 1
  - Regex: '^".*"$'         # プロジェクト内ヘッダ（"...」）
    Priority: 2
  - Regex: '.*'             # フォールバック
    Priority: 3

# ------------------------------------------------------------
# コメントや整形対象外指定
# ------------------------------------------------------------
# clang-format off / on コメントで特定範囲の整形を無効化できます。
#   // clang-format off
#   コード
#   // clang-format on
# ------------------------------------------------------------
