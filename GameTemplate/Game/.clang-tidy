# ============================================================
# .clang-tidy
# ============================================================
# Clang-Tidy は C++ 用の静的解析ツールです。
# コードの命名規則・安全性・可読性・モダンC++化などを自動で検査します。
#
# この設定では、あなたの希望に合わせた命名規則：
#   - 関数：PascalCase
#   - public変数：PascalCase
#   - private変数：m_ + camelCase
#   - static変数：s_ + camelCase
#   - 定数：ALL_CAPS_SNAKE_CASE
# を適用しています。
# ============================================================

Checks: >
  readability-identifier-naming,
  modernize-*,
  cppcoreguidelines-*,
  performance-*,
  bugprone-*,
  portability-*

CheckOptions:
  # ------------------------------------------------------------
  # 型・関数・名前空間
  # ------------------------------------------------------------
  - { key: readability-identifier-naming.NamespaceCase,           value: lower_case }   # 名前空間は小文字
  - { key: readability-identifier-naming.ClassCase,               value: PascalCase }   # クラスはPascalCase
  - { key: readability-identifier-naming.StructCase,              value: PascalCase }   # 構造体もPascalCase
  - { key: readability-identifier-naming.EnumCase,                value: PascalCase }   # enumもPascalCase
  - { key: readability-identifier-naming.EnumConstantCase,        value: UPPER_CASE }   # 列挙子は全大文字スネーク
  - { key: readability-identifier-naming.FunctionCase,            value: PascalCase }   # 関数はPascalCase

  # ------------------------------------------------------------
  # 変数の命名ルール
  # ------------------------------------------------------------
  - { key: readability-identifier-naming.VariableCase,            value: camelBack }    # 通常変数はcamelCase
  - { key: readability-identifier-naming.PublicMemberCase,        value: PascalCase }   # publicメンバはPascalCase
  - { key: readability-identifier-naming.MemberCase,              value: camelBack }    # private/protectedメンバはcamelCase
  - { key: readability-identifier-naming.PrivateMemberPrefix,     value: m_ }           # private変数は m_ 接頭辞
  - { key: readability-identifier-naming.ProtectedMemberPrefix,   value: m_ }           # protected変数も同様
  - { key: readability-identifier-naming.StaticMemberPrefix,      value: s_ }           # static変数は s_ 接頭辞

  # ------------------------------------------------------------
  # 定数・マクロなど
  # ------------------------------------------------------------
  - { key: readability-identifier-naming.ConstantCase,            value: UPPER_CASE }   # 定数は全大文字スネーク
  - { key: readability-identifier-naming.ConstantPrefix,          value: "" }           # プレフィックスなし
  - { key: readability-identifier-naming.MacroDefinitionCase,     value: UPPER_CASE }   # マクロも全大文字

  # ------------------------------------------------------------
  # その他
  # ------------------------------------------------------------
  - { key: readability-identifier-naming.IgnoreMainLikeFunctions, value: 1 }             # main関数は除外
