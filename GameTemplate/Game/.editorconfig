# ============================================================
# .editorconfig
# ============================================================
# このファイルはエディタ共通の基本書式ルールを定義します。
# Visual Studio / VS Code / Rider / CLion など多くのIDEが自動認識します。
# 
# 目的：
# - 改行コード、文字コード、インデントなどを統一
# - 各開発者のIDE設定の違いによるフォーマット崩れを防止
# ============================================================

# このファイルがルート設定であることを明示
root = true

# ------------------------------------------------------------
# 全ファイル共通設定
# ------------------------------------------------------------
[*]
charset = utf-8               # 文字コード：UTF-8
end_of_line = crlf            # 改行コード：Windowsスタイル (CRLF)
insert_final_newline = true   # ファイル末尾に改行を自動追加
trim_trailing_whitespace = true # 行末の不要な空白を自動削除

# ------------------------------------------------------------
# C/C++ ソースコード共通設定
# ------------------------------------------------------------
[*.{c,cpp,h,hpp,ixx,inl}]
indent_style = space          # インデントはスペースで統一
indent_size = 4               # インデント幅は4スペース
